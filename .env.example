# Copy to .env and fill in. Never commit .env.

# Postgres
DATABASE_URL=postgres://postgres@127.0.0.1:5432/profsol

# Redis
REDIS_URL=redis://127.0.0.1:6379

# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Auth (Clerk). Enforcement stays off until dev and test are done on mock data.
# Rule 9 in CLAUDE.md: wire it now, flip it on later.
AUTH_ENFORCED=false
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# GoHighLevel. Outbound calls are queued through Redis, never fired inline.
GHL_API_BASE=https://services.leadconnectorhq.com
GHL_API_KEY=
GHL_LOCATION_ID=

# Accept Blue is reached through GoHighLevel. The custom stack stores a
# payment reference only and never sees raw bank credentials.
ACCEPT_BLUE_WEBHOOK_SECRET=
