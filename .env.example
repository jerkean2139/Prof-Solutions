# Copy to .env and fill in. Never commit .env.

# Postgres
DATABASE_URL=postgres://postgres@127.0.0.1:5432/profsol
# TLS to Postgres. "auto" reads sslmode out of DATABASE_URL, which is right for
# both a managed private URL (plaintext) and a public proxy URL (TLS with a
# certificate Node does not know). Force it with require / disable / verify-full.
DATABASE_SSL=auto

# Redis
# On a private network whose hostname is IPv6-only (Railway's *.railway.internal),
# the app already defaults to family 0 so the name resolves. Append ?family=4 to
# force IPv4 if you ever need to.
REDIS_URL=redis://127.0.0.1:6379

# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Auth (Clerk). Enforcement stays off until dev and test are done on mock data.
# Rule 9 in CLAUDE.md: wire it now, flip it on later.
AUTH_ENFORCED=false
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# GoHighLevel. Outbound calls are queued through Redis, never fired inline.
# GHL_API_KEY is a v2 Bearer token (OAuth access token or Private Integration
# token). Without it the client logs and skips (no calls go out).
GHL_API_BASE=https://services.leadconnectorhq.com
GHL_API_KEY=
GHL_LOCATION_ID=
# Custom field IDs are specific to your GHL location and must be filled in from
# your account. Maps our logical names to your field IDs. Unmapped = skipped.
# Example: {"sale_total_raised":"CF_ID_1","sale_unit_count":"CF_ID_2","next_sale_target":"CF_ID_3","incentive":"CF_ID_4","tracking_number":"CF_ID_5","carrier":"CF_ID_6"}
GHL_CUSTOM_FIELD_IDS={}
# Batch under GHL's current rate limits (read their docs before tuning).
GHL_RATE_LIMIT_MAX=10
GHL_RATE_LIMIT_DURATION_MS=1000

# Accept Blue is reached through GoHighLevel. The custom stack stores a
# payment reference only and never sees raw bank credentials.
ACCEPT_BLUE_WEBHOOK_SECRET=

# Phase 3 read-only ops agent (the "Ask" tab). Setting this turns the
# natural-language planner on; without it POST /agent/query reports that plainly
# rather than fabricating SQL, and the SQL guard, the read-only role, and schema
# introspection all still work.
ANTHROPIC_API_KEY=
# Belt-and-suspenders caps on any agent query.
AGENT_QUERY_MAX_ROWS=200
AGENT_QUERY_TIMEOUT_MS=5000
# Run agent queries under the profsol_readonly role. The READ ONLY transaction
# protects even when this is off; leave on in production.
AGENT_USE_READONLY_ROLE=true
