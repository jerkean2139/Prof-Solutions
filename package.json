{
  "name": "prof-solutions",
  "version": "0.0.0",
  "private": true,
  "description": "Operational backbone for Profitable Solutions team-based fundraising",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:up": "tsx src/db/migrate.ts up",
    "migrate:down": "tsx src/db/migrate.ts down",
    "migrate:status": "tsx src/db/migrate.ts status",
    "migrate:reset": "tsx src/db/migrate.ts reset",
    "seed": "tsx src/seed/seed.ts",
    "snapshot:rebuild": "tsx src/inventory/rebuild.ts",
    "ghl:preflight": "tsx scripts/ghl-preflight.ts",
    "dev": "tsx watch src/http/server.ts",
    "worker": "tsx src/worker.ts",
    "start": "node dist/http/server.js",
    "start:worker": "node dist/worker.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@clerk/backend": "^1.34.0",
    "bullmq": "^5.34.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
